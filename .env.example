# Copy to `.env` and adjust. Never commit `.env`.
# `docker compose` requires this file (env_file) — fill values before `up`.
# Volumes must resolve outside the repository (NFR-9 / AD-3).

# Optional. If omitted, Compose defaults to ${HOME}/melos (outside the repo).
# To override, set an absolute host path, e.g.:
#   MELOS_DATA=/Users/you/melos
# Do not leave MELOS_DATA= empty — an empty value overrides the default and binds /pgdata.

POSTGRES_USER=melos
POSTGRES_PASSWORD=melos_dev_change_me
POSTGRES_DB=melos
# Compose builds DATABASE_URL for api from POSTGRES_* (host `db`). URL-encode special chars in the password.

# ui — server-side only (same-origin BFF at /api/* → api; avoid NEXT_PUBLIC_API_URL for auth)
API_INTERNAL_URL=http://api:8000

# Node inspector ports for remote debugging (docker-compose.dev.yml only, dev
# builds only — never reaches the prod compose path). UI_DEBUG_WORKER_PORT is
# the inspector for the actual request-handling process ("next-server") and
# MUST be UI_DEBUG_PORT + 1 — Next.js hardcodes that offset internally when
# it forks the child, it isn't independently configurable here.
# In a worktree, scripts/worktree/ensure.sh generates a unique pair per
# worktree path automatically (see its generated overrides block).
# These defaults only apply to the primary checkout. Update the
# `port` field in your nvim config's lua/plugins/dap.lua to match. See JS-DAP.md.
# UI_DEBUG_PORT=9229
# UI_DEBUG_WORKER_PORT=9230

# Auth session (AD-8) — api is the single cookie issuer; ui BFF forwards Set-Cookie.
# Opaque session token stored in Postgres; cookie is httpOnly.
SESSION_SECRET=replace_with_long_random_string
SESSION_COOKIE_NAME=melos_session
# Local Compose over HTTP: false. Homelab/prod behind HTTPS: true (see docker-compose.prod.yml).
SESSION_COOKIE_SECURE=false

# Gemini (AI/LLM Integration)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must equal the recipe_embedding column (768, migration 0014).
GEMINI_EMBED_DIM=768
GEMINI_TEXT_TIMEOUT_S=10
# Seconds to wait before "unavailable" for image input, picture capture (spec 041).
GEMINI_IMAGE_TIMEOUT_S=30
# Scheduled ingredient translation (spec 073). The model name has no code default, so it must be set.
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
JOBS_INTERVAL_SECONDS=3600
JOBS_TRANSLATE_BATCH_SIZE=50
JOBS_RUN_ONCE=0
JOBS_HEARTBEAT_PATH=/tmp/jobs-heartbeat
# Recipe embeddings and search (spec 019). The worker runs inside the api process.
# Text that is embedded: toon (PRD B.3 shape) or plain.
EMBED_TEXT_STRATEGY=toon
EMBEDDING_WORKER_ENABLED=true
# Longest idle wait of the worker, in seconds.
EMBED_WORKER_POLL_S=5
# Recipes per embedding call.
EMBED_BATCH_SIZE=1
# Retry after a failed embedding: first wait, growth per failure, longest wait (seconds).
EMBED_RETRY_FIRST_WAIT_S=60
EMBED_RETRY_GROWTH=1.5
EMBED_RETRY_CAP_S=7200
# Score at or above which a search result is marked "close" (provisional, spec 019 R12).
SEARCH_MIN_CLOSENESS=0.65
# Search result records are deleted after this many days.
SEARCH_RECORD_RETENTION_DAYS=180
# Paste limit for recipe text, in characters after trimming (spec 016 FR-002).
RECIPE_TEXT_MAX_CHARS=5000
# Characters of page Markdown per assistant request, 1000 to 10000 (spec 026).
RECIPE_PAGE_BATCH_CHARS=10000
# Most assistant requests per link capture, 1 to 8 (spec 026).
RECIPE_PAGE_MAX_BATCHES=4

SESSION_COOKIE_SAMESITE=lax
# FR-4 / Story 1.5 — email verification config gate (default off).
# false/absent: signup is usable without verifying (FR-1).
# true: gated flows (invite acceptance / secure recovery) require verified email;
#       not a global login wall or profile/settings product.
EMAIL_VERIFICATION_REQUIRED=false

# Public browser origin used in password-reset, verification, and invite email links.
PUBLIC_APP_URL=http://localhost:3000

# SMTP — required for password reset / email verification / invites (NFR-10, Assumption 3).
# Use a real SMTP provider (e.g., Gmail app password). Misconfigured SMTP fails loudly:
# sending requests return 503 smtp_config_error and are logged — silent success is never used.
# All environments (dev, staging, prod) must have configured SMTP for testing these flows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Melos <noreply@example.com>
# Implicit TLS (port 465): SMTP_USE_TLS=true. STARTTLS (port 587): SMTP_STARTTLS=true (default when USE_TLS=false).
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# Auth rate limits — api enforces; ui BFF forwards X-Melos-Client-IP + Retry-After.
# Single-worker Compose: allowance × workers if you scale api replicas.
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_SIGN_IN_MAX=20
AUTH_RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX=5
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_VERIFY_REQUEST_MAX=5
AUTH_RATE_LIMIT_VERIFY_REQUEST_WINDOW_SECONDS=3600
# BFF sets this header from the browser-facing peer; api trusts it only from TRUSTED_PROXY_IPS.
AUTH_CLIENT_IP_HEADER=X-Melos-Client-IP
# Comma-separated IPs/CIDRs/hostnames allowed to set AUTH_CLIENT_IP_HEADER.
# Default = Docker bridge (172.16/12) + loopback — NOT blanket RFC1918 (no 10/8, 192.168/16).
# If api is published beyond Compose, pin the ui service CIDR only.
# Empty = never honor the header (direct api / TestClient uses peer host).
TRUSTED_PROXY_IPS=172.16.0.0/12,127.0.0.1,::1

# Operator PDF volume — bind-mounted from
# ${MELOS_DATA}/pdfs, same base dir as Postgres data, outside the repo.
# Optional: the container-internal path defaults to /data/pdfs; leave unset
# unless you need to customize that internal path (the host-side location is
# still controlled by MELOS_DATA above). Do not set an empty value —
# same pitfall as MELOS_DATA above.
# PDF_STORAGE_PATH=/data/pdfs

# --- dev seed (never enable in prod) ---
# Seeds one pre-verified account (with "My kitchen") at api boot so a fresh
# stack is testable. With a shared kitchen it also seeds a second, member account
# and one recipe per member. See api/scripts/README.md.
# On by default under docker-compose.dev.yml; set to 0 here to opt out.
# Invent these values — never use a real email or password.
# SEED_DEV_USER=0
# SEED_DEV_USER_EMAIL=dev@example.com
# SEED_DEV_USER_PASSWORD=pass12word34
# SEED_DEV_USER_ALIAS=DevCook
# The seeded owner is an admin (/admin); on by default under docker-compose.dev.yml.
# SEED_DEV_USER_ADMIN=1
# SEED_DEV_USER_KITCHEN="Dev's Kitchen"
# SEED_DEV_MEMBER_EMAIL=ved@example.com
# SEED_DEV_MEMBER_PASSWORD=pass12word34
# SEED_DEV_MEMBER_ALIAS=VedCook
# Real recipes for the seed, read over HTTPS from a running Melos app (production) by
# signing in as an account there (api/scripts/seed_source_recipes.py). Unset URL = skipped.
# Values may reference other .env values as ${NAME}; Compose expands them.
# SEED_RECIPES_SOURCE_NOTEBOOKS: comma-separated notebook names; empty = all the account reads.
# PROD_HOST=melos.example.com
# SEED_RECIPES_SOURCE_URL=https://${PROD_HOST}
# SEED_RECIPES_SOURCE_EMAIL=<production account email>
# SEED_RECIPES_SOURCE_PASSWORD=<production account password>
# SEED_RECIPES_SOURCE_NOTEBOOKS=Demo Kitchen,Mi cocina
