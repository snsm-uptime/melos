# Production environment template for Melos
# Copy to .env on the production server and fill in all values
# NEVER commit this file or the actual .env to version control

# --- Data Storage ---
# Absolute path to data directory (outside repo). Create with `mkdir -p <path> && chown 999:999 <path>`
MELOS_DATA=/var/melos

# --- PostgreSQL ---
# Username and password for the database (use secure, random values)
POSTGRES_USER=melos
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_32_CHAR_PASSWORD_VIA_openssl_rand_base64_32
POSTGRES_DB=melos
# Compose builds DATABASE_URL for api from POSTGRES_* (host `db`)

# --- API ---
API_INTERNAL_URL=http://api:8000

# --- Auth Session (AD-8) ---
# Use: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_SECURE_32_CHAR_SECRET_VIA_openssl_rand_base64_32
SESSION_COOKIE_NAME=melos_session
# Production behind HTTPS reverse proxy: true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict

# --- Public URL ---
# Used in password-reset, verification, and invite email links
# MUST be the public domain with HTTPS
PUBLIC_APP_URL=https://melos.example.com

# --- Gemini (AI/LLM Integration) ---
GEMINI_API_KEY=your-actual-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_DIM=768

# --- SMTP ---
# Required for password reset, email verification, and kitchen invites
# Use a real SMTP provider (Gmail app password, AWS SES, SendGrid, etc.)
# Misconfigured SMTP fails loudly: sending requests return 503 smtp_config_error
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=Melos <noreply@melos.example.com>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# --- Auth Rate Limits ---
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_SIGN_IN_MAX=20
AUTH_RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX=5
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_VERIFY_REQUEST_MAX=5
AUTH_RATE_LIMIT_VERIFY_REQUEST_WINDOW_SECONDS=3600

# --- Trusted Proxies ---
# Reverse proxy IP or CIDR (the only service that can set X-Melos-Client-IP)
# Example: 192.0.2.1 for a single IP, or 192.0.2.0/24 for a subnet
TRUSTED_PROXY_IPS=<reverse-proxy-ip>,127.0.0.1,::1

# --- Dev Seed ---
# NEVER enable in production
SEED_DEV_USER=0
