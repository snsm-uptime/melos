{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/worktree/ensure.sh",
            "timeout": 600,
            "statusMessage": "Setting up the worktree"
          }
        ]
      }
    ]
  }
}
